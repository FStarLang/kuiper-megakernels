module KPlay.Tightness.Flashmoe.Statement
(* GENERATED by tightness.py from proofs/flashmoe-spec/KPlay.Spec.fst. Do not edit. *)
open FStar.Real
module K = KPlay.Spec
module N = KPlay.Numbers

(* The kernels' postcondition is the spec at its float number types. *)
let float_instance : prop =
  forall (x:K.inputs) (y:K.outputs). K.postcondition x y <==> K.spec N.bf16 N.f32 x y

(* Over exact reals the spec defines a function. *)
let nonempty : prop = exists (x:K.inputs_t real). K.input_domain x

let answers : prop =
  forall (x:K.inputs_t real). K.input_domain x ==>
    (exists (y:K.outputs_t real). K.spec N.exact N.exact x y)

let unique : prop =
  forall (x:K.inputs_t real) (y1 y2:K.outputs_t real).
    K.input_domain x /\ K.spec N.exact N.exact x y1 /\ K.spec N.exact N.exact x y2 ==>
    N.veq y1.K.expert_demand y2.K.expert_demand /\
    N.meq y1.K.token_indices y2.K.token_indices /\
    N.meq y1.K.probabilities y2.K.probabilities /\
    N.meq y1.K.survival y2.K.survival

let tight : prop = float_instance /\ nonempty /\ answers /\ unique
